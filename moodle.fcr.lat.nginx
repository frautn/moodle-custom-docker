server {
    listen 80;
    listen [::]:80;
    server_name moodle.fcr.lat;
    return 301 https://moodle.fcr.lat$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name moodle.fcr.lat;

    ssl_certificate /etc/ssl/certs/domain-fcr.cert.pem;
    ssl_certificate_key /etc/ssl/private/private-fcr.key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 110M;

    location = /healthz {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Proxy "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    access_log /var/log/nginx/moodle.access.log;
    error_log  /var/log/nginx/moodle.error.log;
}
